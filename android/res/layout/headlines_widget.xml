<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wroot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/wtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Leitura · Para ti" android:textColor="#FF7A59" android:textSize="13sp" android:textStyle="bold"
        android:letterSpacing="0.04" />
    <TextView android:id="@+id/wempty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Abre o Leitura para carregar as notícias."
        android:textColor="#C4BFCD" android:textSize="13sp" />
    <TextView android:id="@+id/s1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textColor="#8A8494" android:textSize="11sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/t1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#F2EFF7" android:textSize="14sp" android:fontFamily="serif"
        android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
    <TextView android:id="@+id/s2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textColor="#8A8494" android:textSize="11sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/t2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#F2EFF7" android:textSize="14sp" android:fontFamily="serif"
        android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
    <TextView android:id="@+id/s3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textColor="#8A8494" android:textSize="11sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/t3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#F2EFF7" android:textSize="14sp" android:fontFamily="serif"
        android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
    <TextView android:id="@+id/s4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textColor="#8A8494" android:textSize="11sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/t4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#F2EFF7" android:textSize="14sp" android:fontFamily="serif"
        android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="1dp" />
</LinearLayout>
